BACKEND_PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
# Host port for Docker. Use 0 to have Docker select a free port.
SCHOLARLM_FRONTEND_PORT=3000
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_VISION_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
OPENROUTER_SPEECH_MODEL=fish-audio/s2.1-pro-free:free
# Ordered free chat/vision fallbacks. openrouter/free is the final dynamic router.
OPENROUTER_ROUTING_MODELS=google/gemma-4-31b-it:free,openrouter/free
OPENROUTER_MAX_INPUT_PRICE=0.2
OPENROUTER_MAX_OUTPUT_PRICE=0.4
# Optional free ngrok tunnel. Get a token from the ngrok dashboard.
NGROK_AUTHTOKEN=
NGROK_INSPECTOR_PORT=4040
